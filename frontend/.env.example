# StandOut Frontend Environment Variables

# Supabase (Optional for worldwide instant link sharing)
# Create a free project at https://supabase.com
# Then copy your Project URL and anon public key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API URL (Default is /api for local proxy)
# VITE_API_BASE_URL=http://localhost:8000/api
